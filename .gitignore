data
data/raw/
data/processed/
data/factor/
data/csi500_index_weight_201601_202512.csv
data/csi500_index_weight_201201_202512.csv

# 报告图片（可复现，不入库）
reports/**/*.png
reports/**/*.pdf

# 含个人信息的最终报告仅保留在本机；如需入库应先生成脱敏版本
paper/最终报告/*含个人信息*.pdf

# ============================================================
# 实验归档（experiments/）
# ============================================================
# PNG/PDF/Parquet 等生成产物不入库；CSV/JSON/MD 入库保留历史对比
experiments/**/*.png
experiments/**/*.pdf
experiments/**/*.parquet
experiments/**/*.feather
experiments/**/*.pkl
experiments/**/run_log*.txt*

